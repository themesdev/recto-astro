---
// Newsletter (item.json): one labelled, required address field and a button, posting to action without JavaScript;
// in a band beside the heading (inline) or in a card. After a submit the page passes status (and error, value).
import FormMessage from '../../../parts/field/FormMessage.astro';
import Honeypot from '../../../parts/field/Honeypot.astro';
import SectionHead from '../../../parts/section-head/SectionHead.astro';
import { headingId } from '../../../parts/section-head/id';
import { describedBy, fieldIds, formBase, HONEYPOT_NAME, type FormStatus } from '../../../parts/field/shared';
import { spacingAttr, toneAttr } from '../../../parts/kinds';
import { cn } from '../../../recipes/cn';
import { newsletterClasses } from './shared';
import { NEWSLETTER_DEFAULTS, type NewsletterContent } from './types';

export interface Props extends NewsletterContent {
  status?: FormStatus | null;
  error?: string | null;
  value?: string | null;
  /** The honeypot's name (default company_website); false leaves it out. */
  honeypot?: string | false | null;
  id?: string;
  class?: string;
}
const { eyebrow, heading, lead, action, emailName, emailLabel, buttonLabel, note, privacy, hiddenFields, successMessage, errorMessage, variant, tone, spacing, rules, status, error, value, honeypot, id, class: className } = Astro.props;
const d = NEWSLETTER_DEFAULTS;
const v = variant ?? d.variant;
const c = newsletterClasses(v, !!error);
const hid = headingId(heading, id);
const base = formBase(heading, id);
const ids = fieldIds(base, 'email');
const noteId = `${base}-note`;
const ownMessage = Astro.slots.has('message');
const trap = honeypot === false ? null : honeypot || HONEYPOT_NAME;
---

<section id={id} data-section="newsletter" data-variant={v} data-tone={toneAttr(tone)} data-spacing={spacingAttr(spacing)} data-rules={rules ? '' : undefined} aria-labelledby={hid} class={cn(c.root, className)}>
  <div class={c.inner}>
    <div class={c.box} data-tone={v === 'band' ? 'accent' : undefined}>
      <SectionHead eyebrow={eyebrow} heading={heading} lead={lead} headingId={hid} align={v === 'card' ? 'center' : 'start'} class={c.head} />
      <form action={action} method="post" class={c.form}>
        {
          status ? (
            <FormMessage status={status}>
              {ownMessage ? <slot name="message" /> : status === 'success' ? (successMessage ?? d.successMessage) : (errorMessage ?? d.errorMessage)}
            </FormMessage>
          ) : null
        }
        {(hiddenFields ?? []).map((h) => <input type="hidden" name={h.name} value={h.value} />)}
        {trap ? <Honeypot base={base} name={trap} /> : null}
        <label for={ids.control} class={c.label}>{emailLabel ?? d.emailLabel}</label>
        <div class={c.row}>
          <input
            id={ids.control}
            name={emailName ?? d.emailName}
            type="email"
            required
            autocomplete="email"
            value={value || undefined}
            aria-invalid={error ? 'true' : undefined}
            aria-describedby={describedBy(error && ids.error, (note || privacy) && noteId)}
            class={c.input}
          />
          <button type="submit" class={c.button}>{buttonLabel ?? d.buttonLabel}</button>
        </div>
        {error ? <p id={ids.error} class={c.error}>{error}</p> : null}
        {
          note || privacy ? (
            <p id={noteId} class={c.note}>
              {note}
              {note && privacy ? ' ' : null}
              {privacy ? <a href={privacy.href} class={c.privacy}>{privacy.label}</a> : null}
            </p>
          ) : null
        }
      </form>
    </div>
  </div>
</section>
