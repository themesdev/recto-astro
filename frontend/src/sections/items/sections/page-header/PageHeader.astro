---
// Page header (item.json): an inner page's h1 at section-heading size, with breadcrumb, eyebrow and lead; aligned to the
// start (stacked) or centred (centered).
import { headingId } from '../../../parts/section-head/id';
import { spacingAttr, toneAttr } from '../../../parts/kinds';
import { cn } from '../../../recipes/cn';
import { pageHeaderClasses } from './shared';
import { PAGE_HEADER_DEFAULTS, type PageHeaderContent } from './types';

export interface Props extends PageHeaderContent {
  id?: string;
  class?: string;
}
const { breadcrumb, eyebrow, heading, lead, variant, tone, spacing, rules, id, class: className } = Astro.props;
const v = variant ?? PAGE_HEADER_DEFAULTS.variant;
const c = pageHeaderClasses(v);
const hid = headingId(heading, id);
---

<section id={id} data-section="page-header" data-variant={v} data-tone={toneAttr(tone)} data-spacing={spacingAttr(spacing)} data-rules={rules ? '' : undefined} aria-labelledby={hid} class={cn(c.root, className)}>
  <div class={c.inner}>
    <div class={c.body}>
      {
        breadcrumb?.length ? (
          <nav aria-label="Breadcrumb">
            <ol role="list" class={c.crumbs}>
              {breadcrumb.map((b) => (
                <li class={c.crumb}>
                  <a href={b.href} class={c.link}>{b.label}</a>
                  <span aria-hidden="true" class={c.sep}>/</span>
                </li>
              ))}
              <li class={c.crumb}>
                <span aria-current="page" class={c.current}>{heading}</span>
              </li>
            </ol>
          </nav>
        ) : null
      }
      <div class={c.head}>
        {eyebrow ? <p class={c.eyebrow}>{eyebrow}</p> : null}
        <h1 id={hid} class={c.heading}>{heading}</h1>
        {lead ? <p class={c.lead}>{lead}</p> : null}
      </div>
    </div>
  </div>
</section>
