---
// Call to action (item.json): a closing heading, a sentence and the page's main action again.
import Actions from '../../../parts/actions/Actions.astro';
import SectionHead from '../../../parts/section-head/SectionHead.astro';
import { headingId } from '../../../parts/section-head/id';
import { spacingAttr, toneAttr } from '../../../parts/kinds';
import { cn } from '../../../recipes/cn';
import { ctaClasses } from './shared';
import { CTA_DEFAULTS, type CtaContent } from './types';

export interface Props extends CtaContent {
  id?: string;
  class?: string;
}
const { heading, lead, actions, note, variant, tone, spacing, rules, id, class: className } = Astro.props;
const v = variant ?? CTA_DEFAULTS.variant;
const c = ctaClasses(v);
const hid = headingId(heading, id);
---

<section id={id} data-section="cta" data-variant={v} data-tone={toneAttr(tone)} data-spacing={spacingAttr(spacing)} data-rules={rules ? '' : undefined} aria-labelledby={hid} class={cn(c.root, className)}>
  <div class={c.inner}>
    <div class={c.box} data-tone={v === 'panel' ? 'inverse' : undefined}>
      <SectionHead heading={heading} lead={lead} headingId={hid} align={v === 'split' || v === 'row' ? 'start' : 'center'} size={v === 'row' ? 'compact' : 'section'} />
      <div class={c.cta}>
        <Actions actions={actions} class={c.actions} />
        {note ? <p class={c.note}>{note}</p> : null}
      </div>
    </div>
  </div>
</section>
