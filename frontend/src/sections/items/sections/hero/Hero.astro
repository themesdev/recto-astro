---
// Hero (item.json): the page's h1 with its lead and buttons; text only (centered), beside an image (split), above it
// (stacked), over a full-bleed photo (overlay), or beside a code window with an install command (code).
import Actions from '../../../parts/actions/Actions.astro';
import LightField from '../../../parts/effects/LightField.astro';
import CopyButton from '../../../parts/copy/CopyButton.astro';
import CodeWindow from '../../../parts/code-window/CodeWindow.astro';
import SectionHead from '../../../parts/section-head/SectionHead.astro';
import { headingId } from '../../../parts/section-head/id';
import { spacingAttr, toneAttr } from '../../../parts/kinds';
import { BLEED_SIZES, bleedSrcset, focusStyle, srcsetAttrs } from '../../../parts/image/responsive';
import { cn } from '../../../recipes/cn';
import { heroClasses } from './shared';
import { HERO_DEFAULTS, type HeroContent } from './types';

export interface Props extends HeroContent {
  id?: string;
  class?: string;
}
const { eyebrow, heading, lead, actions, note, image, background, imageFocus, command, code, variant, tone, spacing, rules, id, class: className } = Astro.props;
const v = variant ?? HERO_DEFAULTS.variant;
const c = heroClasses(v);
const hid = headingId(heading, id);
const align = v === 'split' || v === 'code' ? 'start' : 'center';
const showCode = v === 'code' && code?.code;
---

<section id={id} data-section="hero" data-variant={v} data-tone={toneAttr(tone)} data-spacing={spacingAttr(spacing)} data-rules={rules ? '' : undefined} aria-labelledby={hid} class={cn(c.root, className)}>
  {v !== 'overlay' && v !== 'centered' ? <LightField /> : null}
  {
    v === 'overlay' && background ? (
      <>
        <img src={background.src} srcset={bleedSrcset(background)} sizes={BLEED_SIZES.full} alt={background.alt} width={background.width} height={background.height} class={c.ground} style={focusStyle(imageFocus)} loading="eager" decoding="async" fetchpriority="high" />
        <div class={c.scrim} />
      </>
    ) : null
  }
  {
    v === 'poster' ? (
      <div class={c.posterInner}>
        {eyebrow ? <p class={c.posterEyebrow}>{eyebrow}</p> : null}
        <h1 id={hid} class={c.posterHeading}>{heading}</h1>
        <div class={c.posterBase}>
          {note ? <p class={c.posterMeta}>{note}</p> : <span class={c.posterMeta} />}
          <div class={c.posterText}>
            {lead ? <p class={c.posterLead}>{lead}</p> : null}
            <Actions actions={actions} />
          </div>
        </div>
        {image ? (
          <div class={c.posterFigure}>
            <img src={image.src} {...srcsetAttrs(image, 'container')} alt={image.alt} width={image.width} height={image.height} class={c.image} loading="eager" decoding="async" fetchpriority="high" />
          </div>
        ) : null}
      </div>
    ) : v === 'panel' ? (
      <div class={c.posterInner}>
        <div class={c.panelTop}>
          <SectionHead as="h1" eyebrow={eyebrow} heading={heading} headingId={hid} class={c.panelHead} />
          <div class={c.panelText}>
            {lead ? <p class={c.panelLead}>{lead}</p> : null}
            <div class={c.panelCta}>
              <Actions actions={actions} />
              {note ? <p class={c.note}>{note}</p> : null}
            </div>
          </div>
        </div>
        {image ? (
          <div class={c.panel} data-tone="accent">
            <div class={c.panelFrame}>
              <img src={image.src} {...srcsetAttrs(image, 'container')} alt={image.alt} width={image.width} height={image.height} class={c.panelImage} loading="eager" decoding="async" fetchpriority="high" />
            </div>
          </div>
        ) : null}
      </div>
    ) : (
    <div class={c.inner}>
      <div class={c.text}>
        <SectionHead as="h1" align={align} eyebrow={eyebrow} heading={heading} lead={lead} headingId={hid} class={c.head} />
        {
          actions?.length || note || (v === 'code' && command) ? (
            <div class={c.cta}>
              <Actions actions={actions} class={c.actions} />
              {
                v === 'code' && command ? (
                  <div class={c.command} data-copy-scope>
                    <span class={c.prompt} aria-hidden="true">$</span>
                    <code class={c.commandText} data-copy-source>{command}</code>
                    <CopyButton label="Copy command" />
                  </div>
                ) : null
              }
              {note ? <p class={c.note}>{note}</p> : null}
            </div>
          ) : null
        }
      </div>
      {
        image && (v === 'split' || v === 'stacked') ? (
          <div class={c.figure}>
            <img src={image.src} {...srcsetAttrs(image, v === 'split' ? 'half' : 'container')} alt={image.alt} width={image.width} height={image.height} class={c.image} loading="eager" decoding="async" fetchpriority="high" />
          </div>
        ) : null
      }
      {
        showCode ? <CodeWindow code={code.code} language={code.language} filename={code.filename} class={c.window} /> : null
      }
    </div>
    )
  }
</section>
