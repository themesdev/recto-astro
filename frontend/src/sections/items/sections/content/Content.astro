---
// Content (item.json): a heading and blocks of prose (optional subheading, paragraphs); one column or beside the heading.
import SectionHead from '../../../parts/section-head/SectionHead.astro';
import { headingId } from '../../../parts/section-head/id';
import { spacingAttr, toneAttr } from '../../../parts/kinds';
import { paragraphs } from '../../../parts/text';
import { cn } from '../../../recipes/cn';
import { contentClasses } from './shared';
import { CONTENT_DEFAULTS, type ContentContent } from './types';

export interface Props extends ContentContent {
  id?: string;
  class?: string;
}
const { eyebrow, heading, lead, blocks, variant, tone, spacing, rules, id, class: className } = Astro.props;
const v = variant ?? CONTENT_DEFAULTS.variant;
const c = contentClasses(v, blocks.length);
const hid = headingId(heading, id);
---

<section id={id} data-section="content" data-variant={v} data-tone={toneAttr(tone)} data-spacing={spacingAttr(spacing)} data-rules={rules ? '' : undefined} aria-labelledby={hid} class={cn(c.root, className)}>
  <div class={c.inner}>
    <SectionHead eyebrow={eyebrow} heading={heading} lead={lead} headingId={hid} size={v === 'statement' ? 'display' : 'section'} class={c.head} />
    <div class={c.prose}>
      {
        blocks.map((b) => (
          <div class={c.block}>
            {b.heading ? <h3 class={v === 'statement' ? c.blockHeading : c.subheading}>{b.heading}</h3> : null}
            {paragraphs(b.text).map((p) => (
              <p class={c.paragraph}>{p}</p>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
