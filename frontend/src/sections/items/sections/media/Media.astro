---
// Media (item.json): a wide image (image) or a video with its poster (video), with a caption and an optional heading.
import SectionHead from '../../../parts/section-head/SectionHead.astro';
import { headingId } from '../../../parts/section-head/id';
import { spacingAttr, toneAttr } from '../../../parts/kinds';
import { cn } from '../../../recipes/cn';
import { captionId, markLabel, markerStyle, mediaClasses } from './shared';
import { MEDIA_DEFAULTS, type MediaContent } from './types';
import { srcsetAttrs } from '../../../parts/image/responsive';

export interface Props extends MediaContent {
  id?: string;
  class?: string;
}
const { eyebrow, heading, lead, image, video, captions, caption, callouts, markers, variant, tone, spacing, rules, id, class: className } = Astro.props;
const v = variant ?? MEDIA_DEFAULTS.variant;
const c = mediaClasses(v);
const hid = heading ? headingId(heading, id) : undefined;
const cid = caption ? captionId(caption, id) : undefined;
const marks = markers ?? MEDIA_DEFAULTS.markers;
const dots = marks === 'dots';
const Callouts = marks === 'numbers' ? 'ol' : 'ul';
---

<section
  id={id}
  data-section="media"
  data-variant={v}
  data-tone={toneAttr(tone)}
  data-spacing={spacingAttr(spacing)} data-rules={rules ? '' : undefined}
  aria-labelledby={hid ?? cid}
  aria-label={hid || cid ? undefined : 'Media'}
  class={cn(c.root, className)}
>
  <div class={c.inner}>
    {heading && hid ? <SectionHead eyebrow={eyebrow} heading={heading} lead={lead} headingId={hid} align={v === 'annotated' ? 'split' : 'center'} /> : null}
    {
      v === 'annotated' ? (
        <div class={c.body}>
          <figure class={c.annotatedFigure}>
            <div class={c.annotatedFrame}>
              <img src={image.src} {...srcsetAttrs(image, 'container')} alt={image.alt} width={image.width} height={image.height} class={c.media} loading="lazy" decoding="async" />
              {(callouts ?? []).map((k, i) => (
                <span class={c.marker(dots)} style={markerStyle(k.x, k.y)} aria-hidden="true">{markLabel(marks, i)}</span>
              ))}
            </div>
            {caption ? <figcaption id={cid} class={c.caption}>{caption}</figcaption> : null}
          </figure>
          {callouts?.length ? (
            <Callouts role="list" class={c.callouts}>
              {callouts.map((k, i) => (
                <li class={c.callout}>
                  <span class={c.number(dots)} aria-hidden="true">{markLabel(marks, i)}</span>
                  <div class={c.calloutBody}>
                    <h3 class={c.calloutTitle}>{k.title}</h3>
                    {k.text ? <p class={c.calloutText}>{k.text}</p> : null}
                  </div>
                </li>
              ))}
            </Callouts>
          ) : null}
        </div>
      ) : (
        <figure class={c.figure}>
          <div class={c.frame}>
            {
              v === 'video' && video ? (
                <video controls preload="none" poster={image.src} width={image.width} height={image.height} aria-label={image.alt || undefined} class={c.video}>
                  <source src={video} />
                  {captions ? <track kind="captions" src={captions} label="Captions" default /> : null}
                </video>
              ) : (
                <img src={image.src} {...srcsetAttrs(image, 'container')} alt={image.alt} width={image.width} height={image.height} class={c.media} loading="lazy" decoding="async" />
              )
            }
          </div>
          {caption ? <figcaption id={cid} class={c.caption}>{caption}</figcaption> : null}
        </figure>
      )
    }
  </div>
</section>
