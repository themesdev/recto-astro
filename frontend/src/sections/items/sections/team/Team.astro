---
// Team (item.json): the people behind the product, as cards in a grid or as a compact list; photo or initials, name,
// role and up to three links each.
import Icon from '../../../parts/icon/Icon.astro';
import SectionHead from '../../../parts/section-head/SectionHead.astro';
import { headingId } from '../../../parts/section-head/id';
import { spacingAttr, toneAttr } from '../../../parts/kinds';
import { cn } from '../../../recipes/cn';
import { initials, teamClasses } from './shared';
import { TEAM_DEFAULTS, type TeamContent } from './types';
import { srcsetAttrs } from '../../../parts/image/responsive';

export interface Props extends TeamContent {
  id?: string;
  class?: string;
}
const { eyebrow, heading, lead, people, link, variant, tone, spacing, rules, id, class: className } = Astro.props;
const v = variant ?? TEAM_DEFAULTS.variant;
const c = teamClasses(v);
const hid = headingId(heading, id);
---

<section id={id} data-section="team" data-variant={v} data-tone={toneAttr(tone)} data-spacing={spacingAttr(spacing)} data-rules={rules ? '' : undefined} aria-labelledby={hid} class={cn(c.root, className)}>
  <div class={c.inner}>
    <SectionHead eyebrow={eyebrow} heading={heading} lead={lead} headingId={hid} align={v === 'portraits' ? 'split' : 'center'} />
    <ul role="list" class={c.list}>
      {
        people.map((p) => (
          <li class={c.item}>
            {p.avatar ? (
              <img src={p.avatar.src} {...srcsetAttrs(p.avatar, v === 'portraits' ? 'quarter' : 'avatar')} alt={p.avatar.alt} width={p.avatar.width} height={p.avatar.height} class={c.avatar} loading="lazy" decoding="async" />
            ) : (
              <span class={c.initials} aria-hidden="true">{initials(p.name)}</span>
            )}
            <div class={c.body}>
              <h3 class={c.name}>{p.name}</h3>
              <p class={c.role}>{p.role}</p>
              {p.links?.length ? (
                <ul role="list" class={c.links}>
                  {p.links.map((l) => (
                    <li>
                      <a href={l.href} class={c.link}>
                        {l.label}
                        <span class="sr-only">{`, ${p.name}`}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : null}
            </div>
          </li>
        ))
      }
    </ul>
    {
      link ? (
        <p class={c.more}>
          <a href={link.href} class={c.moreLink}>
            {link.label}
            <Icon name="arrow-right" size={16} />
          </a>
        </p>
      ) : null
    }
  </div>
</section>
