---
// Lines written out in turn (code, a prompt, a log). The whole text is there from the start: a clip uncovers it.
import { cn } from '../../recipes/cn';
import { typeLineStyle } from './shared';

interface Props {
  lines: string[];
  class?: string;
}
const { lines, class: className } = Astro.props;
---

<span class={cn('flex flex-col', className)}>
  {lines.map((line, i) => <span class="s-type block whitespace-pre" style={typeLineStyle(i, line)}>{line || '\u00a0'}</span>)}
</span>
