---
// A Lucide icon from the sections' set (parts/icon/icon-nodes.ts). Decorative unless it has a label.
import { ICON_NODES, type IconName } from './icon-nodes';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: className } = Astro.props;
const nodes = ICON_NODES[name] ?? [];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>{nodes.map(([Tag, attrs]) => <Tag {...attrs} />)}</svg>
