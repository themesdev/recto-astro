---
// A row of links drawn as buttons. Without an explicit emphasis the first is primary and the rest secondary.
import type { Action } from '../kinds';
import { action } from '../../recipes/action';
import { cn } from '../../recipes/cn';

interface Props {
  actions?: Action[] | null;
  class?: string;
  /** Classes for each button (w-full on narrow screens). */
  itemClass?: string;
}
const { actions, class: className, itemClass } = Astro.props;
---

{
  actions?.length ? (
    <div class={cn('flex flex-wrap items-center gap-3', className)}>
      {actions.map((a, i) => (
        <a href={a.href} class={cn(action({ emphasis: a.emphasis ?? (i === 0 ? 'primary' : 'secondary') }), itemClass)}>
          {a.label}
        </a>
      ))}
    </div>
  ) : null
}
