# Copy to .env.local and fill in. README › Set up Sanity. Astro reads .env and .env.local when you run dev or build.

# Your Sanity project (sanity.io/manage). Public: these two reach the browser, nothing else does.
# Leave the project id empty to see the demo content from seed/ (a production build then needs SANITY_FIXTURE=1).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Server only. A Viewer token: the build reads published content with it (so a private dataset works too), and the
# preview (/preview/, in the Studio's Presentation tool) reads drafts with it.
SANITY_API_READ_TOKEN=
# Only for `pnpm seed`: an Editor token. Delete it from this file once the demo content is in.
SANITY_API_WRITE_TOKEN=
# Your deployed Studio (https://<name>.sanity.studio): the only site allowed to show this one in a frame (Presentation),
# and where a click in the preview opens the field.
SANITY_STUDIO_URL=http://localhost:3333

# The address the site lives at (canonical links, sitemap, feed, Open Graph images).
SITE_URL=https://www.example.com

# Where the newsletter form sends each submission, as JSON (a CRM, a chat webhook, an email API).
# Without it the form answers 503 and accepts nothing. In production: npx wrangler secret put FORWARD_URL.
FORWARD_URL=
