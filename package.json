{
  "name": "recto-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Recto, the Astro edition: a free blog template for Astro and Sanity, by themes.dev. Editorial type, a dark mode, visual editing and demo content.",
  "keywords": [
    "Sanity",
    "Astro",
    "blog",
    "template",
    "Tailwind CSS",
    "visual editing",
    "Cloudflare Workers"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter recto-astro-frontend --filter recto-studio dev",
    "dev:astro": "pnpm --filter recto-astro-frontend dev",
    "dev:studio": "pnpm --filter recto-studio dev",
    "build": "pnpm --filter recto-astro-frontend build",
    "preview": "pnpm --filter recto-astro-frontend preview",
    "seed": "pnpm --filter recto-astro-frontend seed",
    "check": "pnpm --filter recto-astro-frontend check",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter recto-astro-frontend lint",
    "test": "pnpm --filter recto-astro-frontend test",
    "validate": "pnpm dlx @sanity/template-validator@3.1.1",
    "studio:deploy": "pnpm --filter recto-studio deploy",
    "deploy:cf": "pnpm --filter recto-astro-frontend deploy:cf",
    "favicon": "pnpm --filter recto-astro-frontend favicon"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "@sanity/cli": "8.28.0",
      "@sanity/cli-build": "7.1.1"
    }
  }
}
